                        state.status,
                    ],
                    spacing=8,
                ),
            ),
        ],
        spacing=12,
        scroll=ft.ScrollMode.AUTO,
    )
    return ft.Container(
        width=320,
        padding=20,
        bgcolor=SLATE_50,
        border=ft.Border(right=ft.BorderSide(1, BORDER)),
        content=content,
    )
