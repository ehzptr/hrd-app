from __future__ import annotations

import os
import socket
import subprocess
import sys
import time


def free_port(start: int = 8080) -> int:
    for port in range(start, start + 50):
        with socket.socket() as sock:
            try:
                sock.bind(("127.0.0.1", port))
                return port
            except OSError:
                pass
    raise RuntimeError("Tidak menemukan port kosong.")


def main() -> None:
    port = free_port(int(os.getenv("HRDASH_PORT", "8080")))
    env = os.environ.copy()
    src = os.path.join(os.path.dirname(__file__), "src")
    env["PYTHONPATH"] = src + os.pathsep + env.get("PYTHONPATH", "")
    env["HRDASH_PORT"] = str(port)

    proc = subprocess.Popen([sys.executable, "-m", "hr_nicegui.app"], env=env)
    try:
        time.sleep(2)
        proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        proc.wait()


if __name__ == "__main__":
    main()
