from __future__ import annotations

from dataclasses import dataclass, field
from datetime import date
from typing import Optional

from services.pipeline import run_attendance_pipeline


@dataclass
class UploadState:
    attendance: Optional[bytes] = None
    attendance_name: str = ""
    master: Optional[bytes] = None
    master_name: str = ""
    leave: Optional[bytes] = None
    leave_name: str = ""
    sales: Optional[bytes] = None
    sales_name: str = ""


@dataclass
class DashboardState:
    uploads: UploadState = field(default_factory=UploadState)
    result: Optional[dict] = None
    error: str = ""
    clock_in: str = "08:00"
    weekday_out: str = "17:00"
    saturday_out: str = "14:00"
    grace_minutes: int = 10
    saturday_working: bool = True
    sunday_off: bool = True
    start_date: Optional[str] = None
    end_date: Optional[str] = None
    holidays: str = ""
    excellent_threshold: float = 90.0
    good_threshold: float = 80.0
    watch_threshold: float = 70.0
    use_late_rate: bool = False
    late_mode: str = "per_occurrence"
    late_rate_per_occurrence: float = 0.0
    late_rate_per_minute: float = 0.0
    use_sales_no_out_rate: bool = False
    sales_no_out_rate: float = 0.0
    use_early_rate: bool = False
    early_rate: float = 0.0
    use_absent_rate: bool = False
    absent_rate: float = 0.0
    w_visit: float = 0.15
    w_test_drive: float = 0.15
    w_spk: float = 0.30
    w_delivery: float = 0.25
    w_conversion: float = 0.15
    company_name: str = "PT. Dealership Maju Bersama"
    company_address: str = "Surabaya, Indonesia"
    overtime_hourly_rate: float = 0.0

    def execute(self) -> dict:
        if not self.uploads.attendance:
            raise ValueError("Upload export mesin absensi terlebih dahulu.")
        holidays = tuple(line.strip() for line in self.holidays.splitlines() if line.strip())
        payroll_args = {
            "late_deduction_mode": self.late_mode,
            "late_deduction_per_occurrence": self.late_rate_per_occurrence if self.use_late_rate and self.late_mode == "per_occurrence" else None,
            "late_deduction_per_minute": self.late_rate_per_minute if self.use_late_rate and self.late_mode == "per_minute" else None,
            "sales_no_clock_out_deduction": self.sales_no_out_rate if self.use_sales_no_out_rate else None,
            "early_leave_deduction_per_minute": self.early_rate if self.use_early_rate else None,
            "absence_deduction_per_day": self.absent_rate if self.use_absent_rate else None,
        }
        sales_weights = {
            "weight_visit": self.w_visit,
            "weight_test_drive": self.w_test_drive,
            "weight_spk": self.w_spk,
            "weight_delivery": self.w_delivery,
            "weight_conversion_rate": self.w_conversion,
        }
        self.result = run_attendance_pipeline(
            self.uploads.attendance,
            self.uploads.attendance_name,
            self.uploads.master,
            self.uploads.leave,
            self.uploads.master_name,
            self.uploads.leave_name,
            self.uploads.sales,
            self.uploads.sales_name,
            self.clock_in,
            self.weekday_out,
            self.saturday_out,
            self.grace_minutes,
            self.saturday_working,
            self.sunday_off,
            date.fromisoformat(self.start_date) if self.start_date else None,
            date.fromisoformat(self.end_date) if self.end_date else None,
            holidays,
            (self.excellent_threshold, self.good_threshold, self.watch_threshold),
            payroll_args,
            sales_weights,
            self.overtime_hourly_rate,
        )
        self.error = ""
        return self.result
