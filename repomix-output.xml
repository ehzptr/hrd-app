from __future__ import annotations

import os
import traceback
from typing import Any

import plotly.graph_objects as go
import polars as pl
from nicegui import ui

from reporting.excel_report import ReportData, generate_workbook
from reporting.payslip import (
    generate_bulk_payslip_excel,
    generate_bulk_payslip_pdf,
)
from application.employee_master import build_employee_master_template
from application.leave import build_leave_template
from application.sales import build_sales_activity_template
from .state import DashboardState


class NiceGUIDashboard:
    def __init__(self) -> None:
        self.state = DashboardState()
        self.content = None
        self.status = None
        self.render()

    def render(self) -> None:
        ui.colors(
            primary="#1f4e78",
            secondary="#64748b",
            accent="#0f766e",
            positive="#16a34a",
            negative="#dc2626",
            warning="#d97706",
        )
        with ui.header().classes("items-center justify-between px-6 h-16 bg-white border-b"):
            ui.label("HR Dashboard").classes("text-xl font-bold text-slate-800")
            ui.label("Attendance · Payroll · Sales Performance").classes("text-sm text-slate-500")

        with ui.row().classes("w-full min-h-[calc(100vh-4rem)] no-wrap"):
            with ui.column().classes("w-80 shrink-0 bg-slate-50 p-4 border-r overflow-y-auto"):
                self.build_sidebar()
            self.content = ui.column().classes("grow p-6 bg-slate-100 gap-5")
            self.render_empty()

    def build_sidebar(self) -> None:
        ui.label("DATA INPUT").classes("text-xs font-bold text-slate-500 tracking-wider")
        self._upload("Export mesin absensi", "attendance")
        self._upload("Employee Master", "master")
        self._upload("Cuti / Izin", "leave")
        self._upload("Sales Activity", "sales")

        with ui.row().classes("w-full gap-2"):
            ui.button("Download Template Cuti", icon="download", on_click=self.download_leave_template).props("outline").classes("grow")
            ui.button("Template Employee", icon="download", on_click=self.download_employee_template).props("outline").classes("grow")
        ui.button("Template Sales Activity", icon="download", on_click=self.download_sales_template).props("outline").classes("w-full")

        ui.separator()
        ui.label("SCHEDULE").classes("text-xs font-bold text-slate-500 tracking-wider")
        self._input("Jam masuk", "clock_in")
        self._input("Pulang Senin–Jumat", "weekday_out")
        self._input("Pulang Sabtu", "saturday_out")
        self._number("Toleransi terlambat (menit)", "grace_minutes", 0, 120)
        self._checkbox("Sabtu hari kerja", "saturday_working")
        self._checkbox("Minggu libur", "sunday_off")
        self._input("Tanggal mulai", "start_date", "date")
        self._input("Tanggal akhir", "end_date", "date")
        self._input("Hari libur", "holidays", textarea=True)

        with ui.expansion("Scoring & Payroll", icon="tune").classes("w-full"):
            self._number("EXCELLENT", "excellent_threshold", 0, 100, 1)
            self._number("GOOD", "good_threshold", 0, 100, 1)
            self._number("WATCH", "watch_threshold", 0, 100, 1)
            self._checkbox("Aktifkan potongan telat", "use_late_rate")
            ui.select({"per_occurrence": "Per kejadian", "per_minute": "Per menit"}, value=self.state.late_mode, label="Mode potongan telat").bind_value(self.state, "late_mode").classes("w-full")
            self._number("Tarif telat / kejadian", "late_rate_per_occurrence", 0, 1000000, 1000)
            self._number("Tarif telat / menit", "late_rate_per_minute", 0, 1000000, 1000)
            self._checkbox("Potongan lupa pulang Sales", "use_sales_no_out_rate")
            self._number("Tarif lupa pulang", "sales_no_out_rate", 0, 1000000, 1000)
            self._checkbox("Potongan pulang cepat", "use_early_rate")
            self._number("Tarif pulang cepat", "early_rate", 0, 1000000, 1000)
            self._checkbox("Potongan mangkir", "use_absent_rate")
            self._number("Tarif mangkir / hari", "absent_rate", 0, 1000000, 1000)

        with ui.expansion("Sales Weights", icon="analytics").classes("w-full"):
            self._number("Visit", "w_visit", 0, 1, 0.01)
            self._number("Test Drive", "w_test_drive", 0, 1, 0.01)
            self._number("SPK", "w_spk", 0, 1, 0.01)
            self._number("Delivery", "w_delivery", 0, 1, 0.01)
            self._number("Conversion", "w_conversion", 0, 1, 0.01)

        with ui.expansion("Payslip", icon="payments").classes("w-full"):
            self._input("Nama perusahaan", "company_name")
            self._input("Alamat perusahaan", "company_address")
            self._number("Tarif lembur / jam", "overtime_hourly_rate", 0, 10000000, 5000)

        ui.button("Proses Data", icon="play_arrow", on_click=self.process).props("unelevated").classes("w-full mt-3")
        self.status = ui.label().classes("text-sm text-slate-500")

    def _upload(self, label: str, key: str) -> None:
        allowed = ".xlsx,.xls,.csv"

        async def handle(e: Any) -> None:
            try:
                file_obj = getattr(e, "content", None) or getattr(e, "file", None)
                if file_obj is None:
                    raise ValueError("Objek file tidak ditemukan.")

                if hasattr(file_obj, "read"):
                    content = file_obj.read()
                    if hasattr(content, "__await__"):
                        content = await content
                else:
                    content = file_obj

                if not content:
                    raise ValueError("File kosong atau tidak dapat dibaca.")

                filename = (
                    getattr(e, "name", None)
                    or getattr(file_obj, "name", None)
                    or "upload"
                )

                ext = os.path.splitext(filename)[1].lower()
                if ext not in {".xlsx", ".xls", ".csv"}:
                    raise ValueError("Format tidak didukung. Gunakan .xlsx, .xls, atau .csv.")

                setattr(self.state.uploads, key, content)
                setattr(self.state.uploads, f"{key}_name", filename)
                self.status.set_text(f"{label}: {filename} ({len(content):,} bytes)")
                ui.notify(f"{label} berhasil di-upload", type="positive")
            except Exception as exc:
                traceback.print_exc()
                setattr(self.state.uploads, key, None)
                setattr(self.state.uploads, f"{key}_name", "")
                self.status.set_text(f"{label}: gagal upload")
                ui.notify(f"{label}: {exc}", type="negative", timeout=7000)

        ui.upload(
            label=label,
            auto_upload=True,
            on_upload=handle,
            multiple=False,
            max_files=1,
        ).props(f"accept={allowed}").classes("w-full")

    def _input(self, label: str, key: str, input_type: str | None = None, textarea: bool = False) -> None:
        element = ui.textarea(label=label) if textarea else ui.input(label=label)
        if input_type:
            element.props(f"type={input_type}")
        element.bind_value(self.state, key).classes("w-full")

    def _number(self, label: str, key: str, min_value: float, max_value: float, step: float = 1) -> None:
        ui.number(label=label, min=min_value, max=max_value, step=step).bind_value(self.state, key).classes("w-full")

    def _checkbox(self, label: str, key: str) -> None:
        ui.checkbox(label).bind_value(self.state, key)

    def process(self) -> None:
        try:
            self.status.set_text("Memproses...")
            self.state.execute()
            self.status.set_text("Selesai")
            self.render_content()
            ui.notify("Analisis berhasil diproses", type="positive")
        except Exception as exc:
            traceback.print_exc()
            self.state.error = str(exc)
            self.status.set_text("Gagal")
            ui.notify(str(exc), type="negative", timeout=7000)

    def clear_content(self) -> None:
        if self.content:
            self.content.clear()

    def render_empty(self) -> None:
        self.clear_content()
        with self.content:
            with ui.card().classes("w-full max-w-3xl mx-auto mt-12 p-10 text-center"):
                ui.icon("dashboard", size="48px").classes("text-slate-400")
                ui.label("Upload data absensi untuk memulai").classes("text-2xl font-bold text-slate-700 mt-4")
                ui.label("Employee Master, Cuti/Izin, dan Sales Activity bersifat opsional.").classes("text-slate-500")

    def render_content(self) -> None:
        self.clear_content()
        r = self.state.result
        if not r:
            return self.render_empty()
        with self.content:
            self.kpis(r)
            with ui.tabs().classes("w-full") as tabs:
                dashboard = ui.tab("Dashboard")
                employees = ui.tab("Employees")
                departments = ui.tab("Departments")
                anomalies = ui.tab("Anomalies")
                payroll = ui.tab("Payroll")
                sales = ui.tab("Sales")
                reports = ui.tab("Reports")
            with ui.tab_panels(tabs, value=dashboard).classes("w-full"):
                with ui.tab_panel(dashboard): self.dashboard_tab(r)
                with ui.tab_panel(employees): self.table_tab("Employee Summary", r["employee_summary"])
                with ui.tab_panel(departments): self.department_tab(r)
                with ui.tab_panel(anomalies): self.table_tab("Anomaly", r["anomalies"])
                with ui.tab_panel(payroll): self.payroll_tab(r)
                with ui.tab_panel(sales): self.sales_tab(r)
                with ui.tab_panel(reports): self.reports_tab(r)

    def kpis(self, r: dict) -> None:
        q = r["quality"]
        summary = r["employee_summary"]
        metrics = [
            ("Karyawan", summary.height),
            ("Hari Hadir", int(summary["Hari_Hadir"].sum()) if "Hari_Hadir" in summary.columns else 0),
            ("Keterlambatan", int(summary["Kali_Terlambat"].sum()) if "Kali_Terlambat" in summary.columns else 0),
            ("Anomali", r["anomalies"].height),
        ]
        with ui.row().classes("w-full gap-4"):
            for label, value in metrics:
                with ui.card().classes("grow p-5"):
                    ui.label(label).classes("text-sm text-slate-500")
                    ui.label(f"{value:,}").classes("text-3xl font-bold text-slate-800")
        with ui.row().classes("w-full"):
            ui.label(f"Quality: {q}").classes("text-xs text-slate-500")

    def dashboard_tab(self, r: dict) -> None:
        trend = r["trend"]
        if not trend.is_empty() and "Tanggal" in trend.columns:
            fig = go.Figure()
            x_vals = trend["Tanggal"].to_list()

            for col in ["Late", "Absent"]:
                if col in trend.columns:
                    fig.add_trace(
                        go.Scatter(
                            x=x_vals,
                            y=trend[col].to_list(),
                            mode="lines+markers",
                            name=col,
                        )
                    )

            fig.update_layout(title="Trend Kehadiran", xaxis_title="Tanggal")
            ui.plotly(fig).classes("w-full")

        with ui.card().classes("w-full"):
            ui.label("Insights HR").classes("text-lg font-bold")
            for insight in r["insights"]:
                ui.label(insight).classes("text-slate-600")


    def department_tab(self, r: dict) -> None:
        d = r["department_summary"]
        if not d.is_empty():
            x_col = d.columns[0]
            y_col = d.columns[1] if len(d.columns) > 1 else d.columns[0]

            fig = go.Figure(
                data=[
                    go.Bar(
                        x=d[x_col].to_list(),
                        y=d[y_col].to_list(),
                    )
                ]
            )
            fig.update_layout(title="Department Overview")
            ui.plotly(fig).classes("w-full")

        self.table_tab("Department Summary", d)

    def payroll_tab(self, r: dict) -> None:
        self.table_tab("Rekap Payroll", r["payroll"])
        if r["payslips"]:
            with ui.row():
                ui.button("Export Semua PDF", on_click=lambda: self.download_bulk_pdf(r))
                ui.button("Export Semua Excel", on_click=lambda: self.download_bulk_excel(r))

    def sales_tab(self, r: dict) -> None:
        if r["sales_performance"].is_empty():
            ui.label("Upload Sales Activity untuk melihat performa sales.").classes("text-slate-500")
            return
        self.table_tab("Sales Performance", r["sales_performance"])
        if not r["combined_view"].is_empty():
            self.table_tab("Attendance vs Sales", r["combined_view"])

    def reports_tab(self, r: dict) -> None:
        ui.button("Download Workbook Lengkap", icon="download", on_click=lambda: self.download_workbook(r)).props("unelevated")
        with ui.row().classes("mt-4"):
            ui.label(f"Periode: {r['period_label'] or '-'}")
            ui.label(f"Rejected: {r['rejected'].height:,}")
            ui.label(f"Unmapped: {r['unmapped'].height:,}")

    def table_tab(self, title: str, df: pl.DataFrame) -> None:
        ui.label(title).classes("text-lg font-bold mb-3")
        if df.is_empty():
            ui.label("Tidak ada data.").classes("text-slate-500")
            return
        columns = [{"name": c, "label": c, "field": c, "sortable": True} for c in df.columns]
        rows = df.to_dicts()
        ui.table(columns=columns, rows=rows, row_key=df.columns[0], pagination={"rowsPerPage": 20}).classes("w-full")

    def download_leave_template(self) -> None:
        ui.download(build_leave_template(), "template_cuti_lembur_kegiatan.xlsx")

    def download_employee_template(self) -> None:
        ui.download(build_employee_master_template(), "employee_master_template.xlsx")

    def download_sales_template(self) -> None:
        ui.download(build_sales_activity_template(), "sales_activity_template.xlsx")

    def download_workbook(self, r: dict) -> None:
        data = ReportData(
            config=r["cfg"], employee_master=r["master"], raw_log=r["clean"], daily_attendance=r["daily"],
            employee_summary=r["employee_summary"], department_summary=r["department_summary"], daily_trend=r["trend"],
            anomalies=r["anomalies"], rejected=r["rejected"], payroll=r["payroll"], sales_activity=r["sales_activity"],
            sales_performance=r["sales_performance"], insights=r["insights"], report_period_label=r["period_label"],
        )
        ui.download(generate_workbook(data), "HR_Dashboard_Report.xlsx")

    def download_bulk_pdf(self, r: dict) -> None:
        ui.download(generate_bulk_payslip_pdf(r["payslips"], self.company_info()), "Slip_Gaji_All.pdf")

    def download_bulk_excel(self, r: dict) -> None:
        ui.download(generate_bulk_payslip_excel(r["payslips"], self.company_info()), "Slip_Gaji_All.xlsx")

    def company_info(self) -> dict:
        return {"name": self.state.company_name, "address": self.state.company_address}


def main() -> None:
    NiceGUIDashboard()
    ui.run(host="127.0.0.1", port=int(os.getenv("HRDASH_PORT", "8080")), title="HR Attendance, Payroll & Sales Dashboard", reload=False, favicon="📊")


if __name__ == "__main__":
    main()
