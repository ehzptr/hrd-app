"""
Regression test for `application.leave.apply_leave_kegiatan`.

This exercises every branch of the original row-by-row implementation
(now rewritten as vectorized Polars expressions) so a future change can't
silently alter behavior:

  - Libur Bersama (group holiday) with and without a scan
  - Approved individual leave (Cuti) with and without a scan
  - Lembur Bersama (group overtime event) with and without a scan,
    including stacking with individual overtime on the same day
  - Individual overtime (Lembur_Karyawan) on its own
  - A normal day with no matching case at all
  - Priority order when holiday + leave + group-overtime-event all land
    on the same date (holiday wins, then leave, then group overtime)
  - A deliberately-preserved quirk from the original code: the Lembur
    Bersama branch does NOT reset Late_Flag/Early_Leave_Flag (only the
    holiday and leave branches do). This test locks that in as documented
    behavior rather than "fixing" it silently.

Run from the repo root with the src/ package on the path, e.g.:

    PYTHONPATH=src python3 tests/test_apply_leave_kegiatan.py

Requires polars + openpyxl to be installed (see pyproject.toml).
"""

from __future__ import annotations

import datetime as dt
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

import polars as pl

from application.leave import (
    ApprovalStatus,
    GroupEvent,
    GroupEventType,
    LeaveLoadResult,
    LeaveRecord,
    OvertimeRecord,
    apply_leave_kegiatan,
)

D = dt.date


def _base_row(no: str, tanggal: dt.date, **overrides: object) -> dict:
    row = {
        "No.": no,
        "Tanggal": tanggal,
        "Scan_Count": 0,
        "Absent_Flag": 1,
        "Is_Working_Day": True,
        "Work_Day_Flag": 1,
        "Present_Flag": 0,
        "Status_Masuk": "Mangkir",
        "Status_Pulang": "Mangkir",
        "Menit_Telat": 0,
        "Menit_Pulang_Cepat": 0,
        "Is_Anomali": 1,
        "Late_Flag": 0,
        "Early_Leave_Flag": 0,
        "Leave_Type": "",
    }
    row.update(overrides)
    return row


def build_daily() -> pl.DataFrame:
    rows = [
        # E1: holiday, no scan
        _base_row("E1", D(2026, 1, 5)),
        # E2: holiday, WITH scan (should keep its "Hadir" status)
        _base_row(
            "E2", D(2026, 1, 5),
            Scan_Count=2, Absent_Flag=0, Present_Flag=1,
            Status_Masuk="Hadir", Status_Pulang="OK",
        ),
        # E3: approved leave, no scan
        _base_row("E3", D(2026, 1, 6)),
        # E4: approved leave, WITH scan
        _base_row(
            "E4", D(2026, 1, 6),
            Scan_Count=2, Absent_Flag=0, Present_Flag=1,
            Status_Masuk="Hadir", Status_Pulang="OK",
        ),
        # E5: lembur bersama event, no scan, no individual OT.
        # Late/Early flags deliberately seeded to 1 to prove the group-
        # overtime branch does NOT reset them (unlike holiday/leave).
        _base_row("E5", D(2026, 1, 7), Late_Flag=1, Early_Leave_Flag=1),
        # E6: same lembur bersama date, PLUS 2.0h individual overtime
        _base_row("E6", D(2026, 1, 7)),
        # E7: individual overtime only, normal present day
        _base_row(
            "E7", D(2026, 1, 8),
            Scan_Count=2, Absent_Flag=0, Present_Flag=1,
            Status_Masuk="Hadir", Status_Pulang="OK",
        ),
        # E8: nothing matches at all
        _base_row("E8", D(2026, 1, 9)),
        # E9: priority test -- holiday + leave + group-OT-event all on the
        # same date, plus 1.0h individual OT. Holiday must win.
        _base_row("E9", D(2026, 1, 10)),
    ]
    schema = {
        "No.": pl.String, "Tanggal": pl.Date, "Scan_Count": pl.Int64,
        "Absent_Flag": pl.Int64, "Is_Working_Day": pl.Boolean, "Work_Day_Flag": pl.Int64,
        "Present_Flag": pl.Int64, "Status_Masuk": pl.String, "Status_Pulang": pl.String,
        "Menit_Telat": pl.Int64, "Menit_Pulang_Cepat": pl.Int64, "Is_Anomali": pl.Int64,
        "Late_Flag": pl.Int64, "Early_Leave_Flag": pl.Int64, "Leave_Type": pl.String,
    }
    return pl.DataFrame(rows, schema=schema)


def build_leave_result() -> LeaveLoadResult:
    return LeaveLoadResult(
        leaves=[
            LeaveRecord("E3", "Employee 3", D(2026, 1, 6), D(2026, 1, 6), "Cuti Tahunan", ApprovalStatus.APPROVED, None, 1),
            LeaveRecord("E4", "Employee 4", D(2026, 1, 6), D(2026, 1, 6), "Cuti Tahunan", ApprovalStatus.APPROVED, None, 2),
            # E9: leave present too, but holiday must still win on that date.
            LeaveRecord("E9", "Employee 9", D(2026, 1, 10), D(2026, 1, 10), "Izin", ApprovalStatus.APPROVED, None, 3),
        ],
        overtimes=[
            OvertimeRecord("E6", "Employee 6", D(2026, 1, 7), dt.time(18, 0), dt.time(20, 0), 2.0, ApprovalStatus.APPROVED, None, 1),
            OvertimeRecord("E7", "Employee 7", D(2026, 1, 8), dt.time(18, 0), dt.time(21, 30), 3.5, ApprovalStatus.APPROVED, None, 2),
            OvertimeRecord("E9", "Employee 9", D(2026, 1, 10), dt.time(18, 0), dt.time(19, 0), 1.0, ApprovalStatus.APPROVED, None, 3),
        ],
        group_events=[
            GroupEvent(D(2026, 1, 5), D(2026, 1, 5), "Libur Nasional", GroupEventType.LIBUR_BERSAMA, source_row=1),
            GroupEvent(D(2026, 1, 7), D(2026, 1, 7), "Pameran Mobil", GroupEventType.LEMBUR_BERSAMA, duration_hours=6.0, source_row=2),
            # E9's date: both a holiday AND a group-overtime event land here.
            GroupEvent(D(2026, 1, 10), D(2026, 1, 10), "Libur Nasional 2", GroupEventType.LIBUR_BERSAMA, source_row=3),
            GroupEvent(D(2026, 1, 10), D(2026, 1, 10), "Lembur Akhir Tahun", GroupEventType.LEMBUR_BERSAMA, duration_hours=6.0, source_row=4),
        ],
    )


def get(result: pl.DataFrame, no: str) -> dict:
    rows = result.filter(pl.col("No.") == no).to_dicts()
    assert len(rows) == 1, f"expected exactly one row for {no}, got {len(rows)}"
    return rows[0]


def check(label: str, actual: object, expected: object) -> None:
    assert actual == expected, f"{label}: expected {expected!r}, got {actual!r}"


def main() -> None:
    daily = build_daily()
    leave_result = build_leave_result()
    result = apply_leave_kegiatan(daily, leave_result)

    failures = 0

    def run(label, actual, expected):
        nonlocal failures
        try:
            check(label, actual, expected)
        except AssertionError as e:
            failures += 1
            print(f"FAIL: {e}")

    # --- E1: holiday, no scan ---
    r = get(result, "E1")
    run("E1 Group_Event", r["Group_Event"], "Libur Nasional")
    run("E1 Absent_Flag", r["Absent_Flag"], 0)
    run("E1 Is_Working_Day", r["Is_Working_Day"], False)
    run("E1 Work_Day_Flag", r["Work_Day_Flag"], 0)
    run("E1 Status_Masuk", r["Status_Masuk"], "Libur Bersama")
    run("E1 Status_Pulang", r["Status_Pulang"], "Libur Bersama")
    run("E1 Is_Anomali", r["Is_Anomali"], 0)
    run("E1 Present_Flag (untouched by holiday case)", r["Present_Flag"], 0)

    # --- E2: holiday, WITH scan -> status must NOT be overwritten ---
    r = get(result, "E2")
    run("E2 Group_Event", r["Group_Event"], "Libur Nasional")
    run("E2 Is_Working_Day", r["Is_Working_Day"], False)
    run("E2 Status_Masuk (kept, scan present)", r["Status_Masuk"], "Hadir")

    # --- E3: approved leave, no scan ---
    r = get(result, "E3")
    run("E3 Leave_Type", r["Leave_Type"], "Cuti Tahunan")
    run("E3 Absent_Flag", r["Absent_Flag"], 0)
    run("E3 Present_Flag", r["Present_Flag"], 1)
    run("E3 Status_Masuk", r["Status_Masuk"], "Cuti Disetujui")
    run("E3 Status_Pulang", r["Status_Pulang"], "Cuti Tahunan")
    run("E3 Is_Working_Day (untouched by leave case)", r["Is_Working_Day"], True)

    # --- E4: approved leave, WITH scan ---
    r = get(result, "E4")
    run("E4 Leave_Type", r["Leave_Type"], "Cuti Tahunan")
    run("E4 Present_Flag (always set)", r["Present_Flag"], 1)
    run("E4 Status_Masuk (kept, scan present)", r["Status_Masuk"], "Hadir")

    # --- E5: lembur bersama, no scan, no individual OT ---
    r = get(result, "E5")
    run("E5 Group_Event", r["Group_Event"], "Pameran Mobil")
    run("E5 Overtime_Hours", r["Overtime_Hours"], 6.0)
    run("E5 Overtime_Status", r["Overtime_Status"], "Approved")
    run("E5 Status_Masuk", r["Status_Masuk"], "Lembur Bersama")
    run("E5 Is_Anomali", r["Is_Anomali"], 0)
    # Preserved quirk: group-overtime branch does NOT reset these.
    run("E5 Late_Flag (quirk: not reset)", r["Late_Flag"], 1)
    run("E5 Early_Leave_Flag (quirk: not reset)", r["Early_Leave_Flag"], 1)

    # --- E6: lembur bersama + individual OT stack ---
    r = get(result, "E6")
    run("E6 Overtime_Hours (2.0 individual + 6.0 event)", r["Overtime_Hours"], 8.0)
    run("E6 Overtime_Status", r["Overtime_Status"], "Approved")

    # --- E7: individual OT only, normal present day ---
    r = get(result, "E7")
    run("E7 Overtime_Hours", r["Overtime_Hours"], 3.5)
    run("E7 Overtime_Status", r["Overtime_Status"], "Approved")
    run("E7 Status_Masuk (untouched)", r["Status_Masuk"], "Hadir")
    run("E7 Group_Event (untouched)", r["Group_Event"], "")

    # --- E8: nothing matches ---
    r = get(result, "E8")
    run("E8 Overtime_Hours (default)", r["Overtime_Hours"], 0.0)
    run("E8 Overtime_Status (default)", r["Overtime_Status"], "")
    run("E8 Group_Event (default)", r["Group_Event"], "")
    run("E8 Status_Masuk (untouched)", r["Status_Masuk"], "Mangkir")

    # --- E9: priority -- holiday beats leave and group-overtime-event ---
    r = get(result, "E9")
    run("E9 Group_Event (holiday wins)", r["Group_Event"], "Libur Nasional 2")
    run("E9 Leave_Type (leave NOT applied)", r["Leave_Type"], "")
    run("E9 Is_Working_Day", r["Is_Working_Day"], False)
    run("E9 Status_Masuk", r["Status_Masuk"], "Libur Bersama")
    # Individual OT is independent of which case wins -- group event hours
    # are NOT added since the overtime-event branch lost to the holiday.
    run("E9 Overtime_Hours (individual only, event not added)", r["Overtime_Hours"], 1.0)
    run("E9 Overtime_Status (individual OT present)", r["Overtime_Status"], "Approved")

    if failures:
        print(f"\n{failures} scenario(s) FAILED")
        sys.exit(1)
    print("All scenarios passed.")


if __name__ == "__main__":
    main()
