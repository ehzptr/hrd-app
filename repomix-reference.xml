    # table = ui.table.from_polars(pl.DataFrame()).classes('w-full')
    with ui.table.from_polars(pl.DataFrame(), title="my team", pagination=10).classes('w-full') as table:
        with table.add_slot('top-right'):
            with ui.input(placeholder='Search').props('type=search').bind_value(table, 'filter').add_slot('append'):
                ui.icon('search')

    # 4. Left Drawer: contains upload controls
    with ui.left_drawer().classes('bg-blue-100') as left_drawer:
        async def handle_upload(e):
            try:
                # Read byte content asynchronously
                file_bytes = await e.file.read()
                
                # Parse with Polars
                df = _read_excel_bytes(file_bytes)
                
                # Update main layout table properties
                table.columns = [{'name': col, 'label': col, 'field': col} for col in df.columns]
                table.rows = df.to_dicts()
                table.update()
                
                ui.notify(f'Successfully loaded {e.file.name}', type='positive')
            except Exception as ex:
                ui.notify(f'Failed to parse file: {str(ex)}', type='negative')

        ui.upload(on_upload=handle_upload, label='Upload Excel File').classes('max-w-full')

    # 5. Floating action button
    with ui.page_sticky(position='bottom-right', x_offset=20, y_offset=20):
        ui.button(on_click=footer.toggle, icon='contact_support').props('fab')


if __name__ in {"__main__", "__mp_main__"}:
